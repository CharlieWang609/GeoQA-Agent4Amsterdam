# Non-secret operator configuration. Copy to .env and replace every placeholder.
OPENAI_API_KEY=replace-me

# Azure deployment (terraform + redeploy)
AZURE_SUBSCRIPTION_ID=replace-me
TF_VAR_resource_group_name=replace-me
TF_VAR_storage_account_name=replace-me
TF_VAR_location=replace-me
TF_VAR_container_registry_name=replace-me
TF_VAR_web_api_image_tag=replace-with-immutable-build-tag
TF_VAR_github_client_id=replace-me
TF_VAR_external_secrets_key_vault_id=replace-me
TF_VAR_openai_api_key_secret_id=replace-me
TF_VAR_github_client_secret_id=replace-me

# Online catalog operations (ingest + metadata annotation)
AZURE_STORAGE_ACCOUNT_URL=https://replace-me.blob.core.windows.net
AZURE_STORAGE_CATALOG_CONTAINER=data
